# ==============================================================================
# AGENT-OVERWATCH CONFIGURATION (.env)
# ==============================================================================
# Agent-Overwatch steers junior coding agents with senior mentor models via MCP.
# This file can be placed at repository root, in ~/.agent-overwatch/.env, or
# configured globally via ~/.agent-overwatch/config.json.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY MENTOR & PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Choose which mentor model evaluates plans, reviews code, and steers execution.
#
# Supported Providers:
#   antigravity  - Zero API key inside Antigravity! Uses native MCP sampling / subagent
#   gemini       - Direct Google Gemini API (requires GEMINI_API_KEY)
#   anthropic    - Direct Anthropic API (requires ANTHROPIC_API_KEY)
#   bedrock      - Amazon Bedrock (requires BEDROCK_API_KEY or AWS credentials)
#   openai       - Direct OpenAI API (requires OPENAI_API_KEY)
#   openrouter   - OpenRouter multi-provider router (requires OPENROUTER_API_KEY)
#   custom       - Custom OpenAI/Anthropic compatible endpoint (Ollama, vLLM, LiteLLM)
OVERWATCH_MENTOR_PROVIDER=antigravity

# Exact Frontier & Senior Model Names:
#
# --- FRONTIER TIER (Tier 3) ---
# Google:
#   OVERWATCH_MENTOR_MODEL=gemini-4-argon
#   OVERWATCH_MENTOR_MODEL=gemini-4.0-argon
#   OVERWATCH_MENTOR_MODEL=gemini-3.1-pro
#
# Anthropic / Bedrock:
#   OVERWATCH_MENTOR_MODEL=claude-opus-5.5
#   OVERWATCH_MENTOR_MODEL=claude-opus-4.5
#   OVERWATCH_MENTOR_MODEL=anthropic.claude-opus-5-5-v1:0      (Bedrock format)
#   OVERWATCH_MENTOR_MODEL=anthropic/claude-opus-5.5           (OpenRouter format)
#
# Fable:
#   OVERWATCH_MENTOR_MODEL=fable-5.1
#
# OpenAI:
#   OVERWATCH_MENTOR_MODEL=o3-pro
#   OVERWATCH_MENTOR_MODEL=o3
#   OVERWATCH_MENTOR_MODEL=gpt-5
#
# Antigravity Native (Zero-API-Key inside Antigravity IDE):
#   OVERWATCH_MENTOR_PROVIDER=antigravity
#   OVERWATCH_MENTOR_MODEL=gemini-4-argon
#   # (or OVERWATCH_MENTOR_MODEL=antigravity/pro)
#
# --- SENIOR TIER (Tier 2) ---
#   OVERWATCH_MENTOR_MODEL=claude-3-7-sonnet-20250219
#   OVERWATCH_MENTOR_MODEL=claude-3-5-sonnet-20241022
#   OVERWATCH_MENTOR_MODEL=gemini-2.5-pro
#   OVERWATCH_MENTOR_MODEL=o3-mini
#
OVERWATCH_MENTOR_MODEL=claude-opus-5.5

# ------------------------------------------------------------------------------
# 2. PROVIDER API KEYS & BASE URLS
# ------------------------------------------------------------------------------
# Google Gemini:
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Anthropic:
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Amazon Bedrock:
# Can authenticate via bearer API key or AWS IAM credentials
BEDROCK_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_BASE_URL=

# OpenAI:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter:
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Custom / Local Endpoint (Ollama, vLLM, LiteLLM, LMStudio):
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=
# OVERWATCH_CUSTOM_PROTOCOL=openai    # 'openai' (default) or 'anthropic'

# ------------------------------------------------------------------------------
# 3. JUNIOR MODEL & TIER ENFORCEMENT
# ------------------------------------------------------------------------------
# Junior model identifier representing the worker agent in the IDE.
# Set to 'auto' to dynamically detect from the active client/agent per tool call.
# Common worker models: gemini-3.8-flash, claude-3-5-haiku, gpt-4o-mini
OVERWATCH_JUNIOR_MODEL=auto

# Permit mentor from same tier as junior (e.g. Sonnet steering Sonnet)
# Default is false (mentor must be strictly higher tier than junior).
OVERWATCH_ALLOW_SAME_TIER=false

# ------------------------------------------------------------------------------
# 4. OPERATIONAL SETTINGS & RELIABILITY
# ------------------------------------------------------------------------------
# Master switch: set to false to completely disable overwatch and bypass all gates
OVERWATCH_ENABLED=true

# Ordered fallback chain if the primary mentor encounters rate limits or errors.
# Comma-separated list of models. Model prefixes determine provider (e.g. openrouter/, bedrock/).
OVERWATCH_FALLBACK_MODELS=gemini-4-argon,claude-opus-5.5,claude-3-7-sonnet-20250219

# Maximum mentor API calls per session (safety circuit breaker)
OVERWATCH_MAX_CALLS_PER_SESSION=50

# Fast Mode: skips deep diff and file analysis on checkpoints for lower latency
OVERWATCH_FAST_MODE=false

# Thinking / Reasoning Token Budget (for models supporting extended reasoning like o3, Claude 3.7)
# OVERWATCH_THINKING_BUDGET=4096

# Structured Tool Timeouts in milliseconds (optional JSON override)
# OVERWATCH_TOOL_TIMEOUTS={"agent-overwatch_plan_check":180000,"agent-overwatch_checkpoint":90000,"agent-overwatch_review":120000,"agent-overwatch_verify":180000,"agent-overwatch_quick_hint":45000}
